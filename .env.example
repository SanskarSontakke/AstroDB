# AstroDB: Environment Configuration

# Supabase Credentials (from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI API Key (for generating vector embeddings & AI query processing)
OPENAI_API_KEY=sk-proj-...

# AstroDB Agent API Key (for securing AI agent tool calls; optional in development)
ASTRODB_API_KEY=astro_sec_agent_live_key_12345
